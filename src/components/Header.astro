---
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-sand/95 backdrop-blur-sm border-b border-line transition-transform duration-300"
>
  <div class="mx-auto max-w-[1120px] px-8 flex justify-between items-center">
    <a href="/" class="flex items-center">
      <img
        src="/carrera_and_business_short_light.png"
        alt="Carrera and Business"
        width="600"
        height="300"
        class="h-24 w-auto"
      />
    </a>
    <nav class="hidden md:block">
      <ul class="flex gap-9 text-[15px]">
        <li><a href="#industrias" class="no-underline hover:text-forest">Industrias</a></li>
        <li><a href="#servicios" class="no-underline hover:text-forest">Servicios</a></li>
        <li><a href="#capacitacion" class="no-underline hover:text-forest">Capacitación</a></li>
        <li><a href="#contacto" class="no-underline hover:text-forest">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function initHeaderScroll() {
    const header = document.getElementById("site-header");
    if (!header) return;

    let lastY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      const goingDown = y > lastY;
      const pastHeader = y > header.offsetHeight;

      if (goingDown && pastHeader) {
        header.style.transform = "translateY(-100%)";
      } else {
        header.style.transform = "translateY(0)";
      }

      lastY = y;
    };

    window.addEventListener("scroll", onScroll, { passive: true });
  }

  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
