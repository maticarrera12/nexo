---
const links = [
  { href: "#industrias", label: "Industrias" },
  { href: "#servicios", label: "Servicios" },
  { href: "#capacitacion", label: "Capacitación" },
  { href: "#contacto", label: "Contacto" },
];
---

<footer class="bg-ink text-sand border-t border-white/10 py-12">
  <div class="mx-auto max-w-[1120px] px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <svg width="28" height="28" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
          <line x1="20" y1="20" x2="20" y2="7" stroke="#FAF7F2" stroke-width="1.6" />
          <line x1="20" y1="20" x2="8" y2="31" stroke="#FAF7F2" stroke-width="1.6" />
          <line x1="20" y1="20" x2="32" y2="31" stroke="#FAF7F2" stroke-width="1.6" />
          <circle cx="20" cy="20" r="5" fill="#FAF7F2" />
          <circle cx="20" cy="7" r="4.5" fill="#00916E" />
          <circle cx="8" cy="31" r="4.5" fill="#B8912B" />
          <circle cx="32" cy="31" r="4.5" fill="#2B5C7A" />
        </svg>
        <div>
          <div class="font-serif text-[17px] leading-[1.1] text-sand">Nexo</div>
          <div class="text-[10px] tracking-[0.16em] uppercase text-gold mt-px">Consulting</div>
        </div>
      </div>

      <nav>
        <ul class="flex flex-wrap gap-x-8 gap-y-2 text-[14px]">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="no-underline text-[#9aa39c] hover:text-forest-dark transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 pt-6 border-t border-white/10 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between text-[13px] text-[#767c78]"
    >
      <span>© {new Date().getFullYear()} Nexo Consulting SAS</span>
      <span>San Isidro, Buenos Aires, Argentina · contacto@nexoconsulting.com.ar</span>
    </div>
  </div>
</footer>
