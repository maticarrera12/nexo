<section class="bg-card py-22" id="capacitacion">
  <div class="mx-auto max-w-[1120px] px-8">
    <div class="flex items-center gap-4 mb-12">
      <span class="text-[15px] text-[#4a504c]">Capacitación</span>
      <div class="flex-1 h-px bg-line"></div>
    </div>
    <h2 class="font-serif font-normal leading-[1.15] text-ink text-[32px] max-w-[18ch]">Formación para cada nivel de la organización</h2>
    <p class="mt-4 max-w-[52ch] text-[#3c433f]">Diseñamos cursos, seminarios y talleres a medida de cada industria, dictados en la planta o en formato in-company.</p>
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h3 class="text-[19px] font-serif font-normal leading-[1.15] text-ink border-t-2 border-gold pt-3.5">Alta dirección</h3>
        <p class="mt-2.5 text-[15px] text-[#4a504c]">Seminarios de toma de decisiones, liderazgo y visión estratégica del negocio.</p>
      </div>
      <div>
        <h3 class="text-[19px] font-serif font-normal leading-[1.15] text-ink border-t-2 border-rust pt-3.5">Mandos medios</h3>
        <p class="mt-2.5 text-[15px] text-[#4a504c]">Talleres de gestión de equipos, indicadores de gestión y resolución de problemas en planta.</p>
      </div>
      <div>
        <h3 class="text-[19px] font-serif font-normal leading-[1.15] text-ink border-t-2 border-blue pt-3.5">Supervisores</h3>
        <p class="mt-2.5 text-[15px] text-[#4a504c]">Cursos de liderazgo de primera línea, comunicación y manejo de conflictos operativos.</p>
      </div>
      <div>
        <h3 class="text-[19px] font-serif font-normal leading-[1.15] text-ink border-t-2 border-forest pt-3.5">Operarios</h3>
        <p class="mt-2.5 text-[15px] text-[#4a504c]">Talleres de procesos, calidad y seguridad, adaptados a cada línea de producción.</p>
      </div>
    </div>
  </div>
</section>
