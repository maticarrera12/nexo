---
const industries = [
  {
    number: "01",
    name: "Metalmecánica",
    description: "Orden de producción, mantenimiento y gestión de equipos en talleres y plantas metalúrgicas.",
    image: "/metalmecanica.png",
    offset: "lg:mt-24",
  },
  {
    number: "02",
    name: "Plástico",
    description: "Procesos de inyección y extrusión, control de calidad y reducción de scrap en planta.",
    image: "/plastico.png",
    offset: "lg:mt-10",
  },
  {
    number: "03",
    name: "Automotriz",
    description: "Estándares de calidad, trazabilidad y eficiencia para proveedores de la cadena automotriz.",
    image: "/automotriz.png",
    offset: "lg:mt-0",
  },
  {
    number: "04",
    name: "Agroindustria",
    description: "Planificación de cosecha, almacenamiento y procesos productivos en plantas agroindustriales.",
    image: "/agroindustria.png",
    offset: "lg:mt-0",
  },
  {
    number: "05",
    name: "Tratamiento de residuos industriales",
    description: "Cumplimiento normativo, seguridad y eficiencia operativa en plantas de tratamiento.",
    image: "/tratamientos.png",
    offset: "lg:mt-16",
  },
  {
    number: "06",
    name: "Agroquímicos",
    description: "Gestión de formulación, almacenamiento seguro y control de calidad en agroquímicos.",
    image: "/agroquimicos.png",
    offset: "lg:mt-0",
  },
];
---

<section class="relative overflow-hidden pt-16 pb-16" id="industrias">
  <div class="hidden lg:block absolute right-0 top-10 bottom-24 w-8 bg-forest-dark"></div>
  <div class="mx-auto max-w-[1120px] px-8">
    <div class="flex items-center gap-4 mb-14">
      <span class="text-[13px] font-medium uppercase tracking-[0.12em] text-[#4a504c]">Industrias</span>
      <div class="w-24 h-px bg-line"></div>
      <span class="text-[13px] font-medium uppercase tracking-[0.12em] text-[#4a504c]">Sectores con los que trabajamos</span>
    </div>

    <h2 class="font-serif text-[42px] leading-[1.15] text-ink">Industrias con las que trabajamos</h2>
    <p class="mt-4 max-w-[52ch] text-[15px] leading-[1.5] text-[#4a504c]">
      Trabajamos con organizaciones de distintos sectores, aportando mirada estratégica y conocimiento profundo de
      cada industria en cada proyecto.
    </p>

    <div class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 lg:items-start gap-x-6 lg:gap-x-0 gap-y-10">
      {
        industries.map((industry) => (
          <div class={`flex flex-col lg:px-5 first:lg:pl-0 last:lg:pr-0 lg:border-l lg:border-r lg:border-line first:lg:border-l-0 last:lg:border-r-0 ${industry.offset}`}>
            <span class="text-[13px] font-semibold text-forest-dark">{industry.number}</span>
            <h3 class="font-serif text-lg leading-snug text-ink mt-2 mb-2">{industry.name}</h3>
            <p class="text-[13px] leading-snug text-[#4a504c]">{industry.description}</p>
            <div class="w-8 h-px bg-line my-4" />
            <img src={industry.image} alt={industry.name} class="w-full h-auto" />
          </div>
        ))
      }
    </div>

    <a
      href="#contacto"
      class="mt-10 inline-flex items-center gap-2 text-[13px] font-medium uppercase tracking-[0.1em] text-ink hover:text-forest-darktransition-colors"
    >
      Ver todas las industrias
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
