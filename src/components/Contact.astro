---
---

<section class="border-t border-line bg-sand py-24 lg:py-32" id="contacto">
  <div class="mx-auto max-w-[1120px] px-8">
    <div class="flex items-center gap-4 mb-16 lg:mb-20">
      <span class="text-[13px] font-medium uppercase tracking-[0.12em] text-[#4a504c]">Contacto</span>
      <div class="flex-1 h-px bg-line"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.05fr] gap-16 lg:gap-24">
      <div class="flex flex-col lg:h-full">
        <h2 class="font-serif font-normal leading-[0.95] text-ink text-[clamp(52px,8vw,96px)]">Hablemos.</h2>
        <div class="w-16 h-[3px] bg-forest-dark mt-8"></div>
        <p class="mt-8 text-lg leading-[1.6] max-w-[38ch] text-[#3c433f]">
          Una primera conversación para entender dónde está tu empresa hoy y qué decisiones pueden llevarla hacia
          adelante.
        </p>

        <div class="mt-16 lg:mt-auto pt-10 border-t border-line">
          <span class="text-[13px] font-medium uppercase tracking-[0.12em] text-ink">Nexo Consulting</span>
          <p class="mt-2 text-[15px] text-[#4a504c]">San Isidro, Buenos Aires · Argentina</p>
          <a
            href="mailto:contacto@nexoconsulting.com.ar"
            class="mt-4 inline-block text-[15px] text-ink border-b border-line hover:border-forest-dark transition-colors"
            >contacto@nexoconsulting.com.ar</a
          >
        </div>
      </div>

      <form id="contact-form" class="flex flex-col gap-10">
        <div>
          <label for="field-nombre" class="flex items-baseline gap-3 mb-3 cursor-text">
            <span class="text-[13px] font-semibold text-forest-dark">01</span>
            <span class="text-[15px] text-ink">Nombre</span>
          </label>
          <input
            id="field-nombre"
            name="nombre"
            type="text"
            required
            class="w-full bg-transparent border-0 border-b border-line py-2.5 text-[16px] text-ink font-sans focus:outline-none focus:border-forest-dark transition-colors"
          />
        </div>

        <div>
          <label for="field-empresa" class="flex items-baseline gap-3 mb-3 cursor-text">
            <span class="text-[13px] font-semibold text-forest-dark">02</span>
            <span class="text-[15px] text-ink">Empresa</span>
          </label>
          <input
            id="field-empresa"
            name="empresa"
            type="text"
            class="w-full bg-transparent border-0 border-b border-line py-2.5 text-[16px] text-ink font-sans focus:outline-none focus:border-forest-dark transition-colors"
          />
        </div>

        <div>
          <label for="field-email" class="flex items-baseline gap-3 mb-3 cursor-text">
            <span class="text-[13px] font-semibold text-forest-dark">03</span>
            <span class="text-[15px] text-ink">Correo electrónico</span>
          </label>
          <input
            id="field-email"
            name="email"
            type="email"
            required
            class="w-full bg-transparent border-0 border-b border-line py-2.5 text-[16px] text-ink font-sans focus:outline-none focus:border-forest-dark transition-colors"
          />
        </div>

        <div>
          <label for="field-mensaje" class="flex items-baseline gap-3 mb-3 cursor-text">
            <span class="text-[13px] font-semibold text-forest-dark">04</span>
            <span class="text-[15px] text-ink">Contanos brevemente qué necesitás</span>
          </label>
          <textarea
            id="field-mensaje"
            name="mensaje"
            rows="2"
            class="w-full bg-transparent border-0 border-b border-line py-2.5 text-[16px] text-ink font-sans resize-none focus:outline-none focus:border-forest-dark transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          class="mt-4 self-start inline-flex items-center gap-2 px-8 py-4 bg-forest-dark text-white text-[15px] rounded-sm transition-colors duration-200 hover:bg-forest"
        >
          Enviar
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    alert("Gracias, te contactaremos pronto.");
  });
</script>
