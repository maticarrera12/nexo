---
---

<section class="bg-forest-dark text-card py-22" id="contacto">
  <div class="mx-auto max-w-[1120px] px-8 grid grid-cols-1 md:grid-cols-2 gap-16">
    <div>
      <h2 class="font-serif font-normal leading-[1.15] text-white text-2xl">Hablemos de tu negocio</h2>
      <p class="text-[#cfd9d4] max-w-[40ch]">Una primera conversación sin costo para entender tu situación y ver si podemos ayudar.</p>
    </div>
    <form id="contact-form" class="flex flex-col gap-3.5">
      <input type="text" placeholder="Nombre" required class="bg-transparent border-0 border-b border-[#4d6e64] text-white py-2.5 px-0.5 font-sans text-[15px] placeholder:text-[#9db3ac] focus:outline-none focus:border-gold" />
      <input type="text" placeholder="Empresa" class="bg-transparent border-0 border-b border-[#4d6e64] text-white py-2.5 px-0.5 font-sans text-[15px] placeholder:text-[#9db3ac] focus:outline-none focus:border-gold" />
      <input type="email" placeholder="Correo" required class="bg-transparent border-0 border-b border-[#4d6e64] text-white py-2.5 px-0.5 font-sans text-[15px] placeholder:text-[#9db3ac] focus:outline-none focus:border-gold" />
      <textarea rows="3" placeholder="Cuéntanos brevemente qué necesitas" class="bg-transparent border-0 border-b border-[#4d6e64] text-white py-2.5 px-0.5 font-sans text-[15px] placeholder:text-[#9db3ac] focus:outline-none focus:border-gold"></textarea>
      <button type="submit" class="mt-3 self-start px-7 py-3.5 bg-lime-green text-ink border-0 text-[15px] cursor-pointer rounded-sm">Enviar mensaje</button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    alert("Gracias, te contactaremos pronto.");
  });
</script>
