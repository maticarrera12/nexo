---
---

<section class="relative overflow-hidden flex items-center md:aspect-[2770/1536]">
  <div class="absolute inset-0 hidden md:block">
    <img src="/background_hero.jpeg" alt="" class="w-full h-full object-cover object-right" />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to right, var(--color-sand) 0%, var(--color-sand) 32%, transparent 55%);"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-[1200px] px-8 py-16 w-full">
    <div class="flex items-center gap-4 mb-16">
      <span class="text-[13px] font-medium uppercase tracking-[0.12em] text-[#4a504c]">Industrias</span>
      <div class="w-32 h-px bg-line"></div>
      <span class="text-[13px] font-medium uppercase tracking-[0.12em] text-[#4a504c]">Capacidades</span>
    </div>

    <div class="max-w-[640px]">
      <h1 class="font-serif font-normal leading-[1.15] text-ink text-[clamp(40px,5.5vw,64px)] max-w-[14ch]">
        Dirección, orden y capacitación para la industria que no se detiene
      </h1>
      <p class="mt-6 text-lg max-w-[46ch] text-[#3c433f]">
        Acompañamos a empresas industriales en la definición de su estrategia, su operación diaria y la formación de
        sus equipos, con planes que la organización puede sostener en el tiempo.
      </p>
      <div class="mt-9 flex items-center gap-4">
        <div class="w-8 h-px bg-line hidden sm:block"></div>
        <a
          class="inline-flex items-center gap-2 px-7 py-3.5 bg-forest-dark text-white no-underline text-[15px] rounded-sm transition-colors duration-200 hover:bg-forest"
          href="#contacto"
        >
          Agenda un diagnóstico
          <span aria-hidden="true">→</span>
        </a>
        <a class="no-underline text-[15px] border-b border-ink pb-[2px]" href="#servicios">Ver servicios</a>
      </div>
    </div>
  </div>

  <div class="hidden md:block absolute right-8 lg:right-16 top-1/2 -translate-y-1/2 max-w-[160px]">
    <div class="font-serif text-5xl text-forest-dark">40+</div>
    <p class="text-[15px] text-ink mt-1.5">
      Empresas industriales asesoradas en estrategia, dirección y capacitación.
    </p>
  </div>
</section>
